	component sdram_system is
		port (
			clk_clk           : in    std_logic                     := 'X';             -- clk
			mem_address       : in    std_logic_vector(24 downto 0) := (others => 'X'); -- address
			mem_byteenable_n  : in    std_logic_vector(1 downto 0)  := (others => 'X'); -- byteenable_n
			mem_chipselect    : in    std_logic                     := 'X';             -- chipselect
			mem_writedata     : in    std_logic_vector(15 downto 0) := (others => 'X'); -- writedata
			mem_read_n        : in    std_logic                     := 'X';             -- read_n
			mem_write_n       : in    std_logic                     := 'X';             -- write_n
			mem_readdata      : out   std_logic_vector(15 downto 0);                    -- readdata
			mem_readdatavalid : out   std_logic;                                        -- readdatavalid
			mem_waitrequest   : out   std_logic;                                        -- waitrequest
			reset_reset_n     : in    std_logic                     := 'X';             -- reset_n
			sdram_addr        : out   std_logic_vector(12 downto 0);                    -- addr
			sdram_ba          : out   std_logic_vector(1 downto 0);                     -- ba
			sdram_cas_n       : out   std_logic;                                        -- cas_n
			sdram_cke         : out   std_logic;                                        -- cke
			sdram_cs_n        : out   std_logic;                                        -- cs_n
			sdram_dq          : inout std_logic_vector(15 downto 0) := (others => 'X'); -- dq
			sdram_dqm         : out   std_logic_vector(1 downto 0);                     -- dqm
			sdram_ras_n       : out   std_logic;                                        -- ras_n
			sdram_we_n        : out   std_logic                                         -- we_n
		);
	end component sdram_system;

